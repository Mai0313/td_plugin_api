# Loopback port Docker Compose publishes the API on
TD_PLUGIN_API_PORT=8700

# PostgreSQL credentials for Docker Compose; the password goes into a URL, so keep it to letters and digits
POSTGRES_PASSWORD=
# POSTGRES_USER=td_plugin_api
# POSTGRES_DB=td_plugin_api

# Where the server keeps its data when run outside Docker Compose; defaults to a SQLite file under data/
# TD_PLUGIN_API_DATABASE_URL=sqlite:///data/td_plugin_api.db
